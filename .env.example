# SESSION_SECRET: Secret key used by the Node.js Express backend to sign host auth tokens.
SESSION_SECRET="replace-with-a-long-random-secret"

# PORT: Port the Node.js Express server listens on (defaults to 3000).
PORT="3000"

# DATA_FILE: Optional custom path for the persistent JSON database file (defaults to ./data/anonquiz-db.json).
DATA_FILE=""

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"
